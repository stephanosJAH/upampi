---
import { MARK } from '../../lib/brand.mjs';
import { manifesto } from '../../data/content';
import { SITE } from '../../config/site';
const b = MARK.bit;
const words = manifesto.split(' ');
---

<div class="core-chapter chapter" data-theme="dark" data-module="hero">
  <!-- Persistent stage for the whole dark chapter (hero → manifesto → marquee) -->
  <div class="core-stage" aria-hidden="true">
    <div class="core-glow"></div>
    <svg class="core-poster" viewBox={MARK.viewBox}>
      <defs>
        <linearGradient id="pg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3a3f47"></stop>
          <stop offset="0.55" stop-color="#14171b"></stop>
          <stop offset="1" stop-color="#0a0b0d"></stop>
        </linearGradient>
      </defs>
      <path d={MARK.path} fill="none" stroke="url(#pg)" stroke-width={MARK.stroke}></path>
      <path d={MARK.path} fill="none" stroke="rgb(205 255 59 / .35)" stroke-width="0.06" transform="translate(0.18 0.18)"></path>
      <rect x={b.x} y={b.y} width={b.size} height={b.size} fill="url(#pg)" stroke="rgb(205 255 59 / .5)" stroke-width="0.06"></rect>
    </svg>
    <canvas class="core-canvas"></canvas>
    <canvas class="core-lines"></canvas>
  </div>

  <!-- 1. HERO — pinned while the core transforms -->
  <section class="hero" id="inicio" data-hero aria-labelledby="hero-title">
    <div class="hero-ui">
      <div class="hero-head wrap">
        <h1 id="hero-title" class="display d-xxl hero-title">
          <span class="ht-line"><span>Software que</span></span>
          <span class="ht-line"><span>trabaja <em class="serif">por ti</em>.</span></span>
        </h1>
        <p class="hero-copy lede" data-hero-fade>
          Digitalizamos tus procesos, construimos las herramientas que tu negocio necesita e implementamos inteligencia
          artificial práctica. Para pymes, negocios independientes y profesionales.
        </p>
        <div class="hero-ctas" data-hero-fade>
          <a class="mono-link" href="/contacto?tipo=diagnostico">Agenda un diagnóstico <span class="arrow">→</span></a>
          <a class="mono-link" href="#soluciones">Ver soluciones <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="hero-foot wrap">
        <a class="scroll-cue mono" href="#manifiesto" data-hero-fade>
          <span class="cue-line" aria-hidden="true"><i></i></span> Desliza para ordenar
        </a>

        <div class="hold-wrap" data-hero-fade>
          <button class="hold mono" type="button" data-hold aria-describedby="hold-help">
            <svg class="hold-ring" viewBox="0 0 36 36" aria-hidden="true">
              <circle cx="18" cy="18" r="16" class="hr-bg"></circle>
              <circle cx="18" cy="18" r="16" class="hr-fg" pathLength="1"></circle>
              <path d="M18 11v14M11 18h14" class="hr-plus"></path>
            </svg>
            <span>Mantén presionado <span class="signal">✦</span> para ordenar</span>
          </button>
          <p id="hold-help" class="mono hold-help">Toca las líneas · funciona con mouse, toque o barra espaciadora</p>
        </div>

        <div class="hero-card" data-hero-fade>
          <div class="info-card">
            <div>
              <svg viewBox={MARK.viewBox} width="22" aria-hidden="true"
                ><path d={MARK.path} fill="none" stroke="currentColor" stroke-width={MARK.stroke}></path><rect
                  x={b.x}
                  y={b.y}
                  width={b.size}
                  height={b.size}
                  style="fill:var(--signal)"></rect></svg
              >
              <span>{SITE.tagline}</span>
            </div>
            <div>Procesos, herramientas<br />e IA para negocios reales</div>
          </div>
          <p class="hero-value">Menos trabajo manual, menos errores y más tiempo para lo que importa.</p>
        </div>
      </div>

      <ol class="phase-captions mono" aria-hidden="true">
        <li data-phase="0"><span class="signal">01</span> Caos — papeles, chats, hojas de cálculo</li>
        <li data-phase="1"><span class="signal">02</span> Estructura — cada dato en su lugar</li>
        <li data-phase="2"><span class="signal">03</span> Sistema — software que piensa contigo</li>
      </ol>
    </div>
  </section>

  <!-- 2. MANIFESTO — scroll-scrubbed word light-up -->
  <section class="manifesto" id="manifiesto" data-module="manifesto" aria-label="Manifiesto">
    <div class="wrap man-grid">
      <p class="label man-label">Manifiesto</p>
      <p class="man-text">
        {words.map((w) => <span class="w">{w} </span>)}
      </p>
    </div>
    <div class="wrap">
      <hr class="hairline man-rule" data-plus />
      <div class="man-foot">
        <p class="mono man-micro">
          Claro primero.<br />Útil siempre.<br />Hecho para durar.
        </p>
        <div class="man-mission">
          <p>
            Nuestra misión es que la tecnología se sienta humana: herramientas simples por fuera, inteligentes por
            dentro, que tu equipo adopte sin miedo.
          </p>
          <a class="mono-link" href="#proceso">Cómo trabajamos <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. MARQUEE — giant triad running in front of the core -->
  <section class="marquee" data-module="marquee" aria-label="Digitaliza, automatiza, escala">
    <p class="mono mq-top wrap">Visión enfocada.<br />Ejecución medida.</p>
    <div class="mq-band" aria-hidden="true">
      <div class="mq-track">
        {
          Array.from({ length: 2 }, () => (
            <div class="mq-set">
              <span>Digitaliza</span>
              <i>+</i>
              <span>Automatiza</span>
              <i>+</i>
              <span>Escala</span>
              <i>+</i>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mono mq-sub spark">De la idea al resultado.</p>
  </section>
</div>

<style>
  .core-chapter {
    position: relative;
    background: var(--ink-1);
  }
  .core-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    margin-bottom: -100vh;
    margin-bottom: -100lvh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .core-canvas,
  .core-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .core-canvas {
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .core-chapter.is-live .core-canvas {
    opacity: 1;
  }
  .core-poster {
    position: absolute;
    left: var(--poster-x, 68%);
    top: var(--poster-y, 52%);
    height: var(--poster-h, 46vh);
    width: auto;
    translate: -50% -50%;
    transform: perspective(900px) rotateY(-27deg) rotateX(9deg);
    filter: drop-shadow(0 0 40px rgb(205 255 59 / 0.08));
    transition: opacity 0.9s ease;
  }
  .core-chapter.is-live .core-poster {
    opacity: 0;
  }
  .core-glow {
    position: absolute;
    left: var(--poster-x, 68%);
    top: var(--poster-y, 52%);
    width: 70vmax;
    height: 70vmax;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(205 255 59 / 0.07), rgb(120 130 145 / 0.05) 40%, transparent 70%);
    opacity: var(--glow-o, 1);
  }

  /* ----- hero ----- */
  .hero {
    position: relative;
    z-index: 1;
    height: 340vh;
  }
  .hero-ui {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: calc(var(--header-h) + 2vh);
    pointer-events: none;
  }
  .hero-ui a,
  .hero-ui button {
    pointer-events: auto;
  }
  .hero-head {
    align-self: start;
    display: grid;
    gap: clamp(1.25rem, 2.5vh, 2rem);
    justify-items: start;
  }
  .hero-title {
    font-size: clamp(3.1rem, 8.2vw, 10rem);
    max-width: 11ch;
  }
  .ht-line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.15em;
    padding-bottom: 0.04em;
  }
  .ht-line > span {
    display: inline-block;
  }
  .hero-title em {
    font-size: 1.04em;
    color: var(--signal);
    letter-spacing: -0.03em;
  }
  .hero-copy {
    max-width: 38ch;
    color: #c6c9c4;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 1.5rem;
    padding-bottom: clamp(1.25rem, 3vh, 2rem);
  }
  .scroll-cue {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    justify-self: start;
    color: var(--fg-muted);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 44px;
    background: var(--line);
    overflow: hidden;
  }
  .cue-line i {
    position: absolute;
    inset: 0;
    background: var(--signal);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  .hold-wrap {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .hold {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.9rem 0.45rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(10 11 13 / 0.4);
    backdrop-filter: blur(6px);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .hold-ring {
    width: 34px;
    height: 34px;
    rotate: -90deg;
  }
  .hr-bg {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .hr-fg {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--hold, 0));
  }
  .hr-plus {
    stroke: var(--fg);
    stroke-width: 1;
    transform-origin: 18px 18px;
    rotate: calc(var(--hold, 0) * 135deg);
  }
  .hold-help {
    font-size: 0.5625rem;
    color: var(--fg-muted);
  }

  .hero-card {
    justify-self: end;
    display: grid;
    gap: 0.9rem;
    max-width: 330px;
  }
  .hero-value {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .phase-captions {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    display: grid;
    gap: 0.5rem;
    color: var(--fg);
  }
  .phase-captions li {
    opacity: 0;
    transform: translateY(8px);
  }

  /* ----- manifesto ----- */
  /* overlaps the hero's tail: the word reveal starts as the core settles */
  .manifesto {
    position: relative;
    z-index: 2;
    margin-top: -55vh;
    padding-block: 8vh 14vh;
  }
  .man-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 6.5fr);
    gap: 2rem;
  }
  .man-label {
    padding-top: 1.2rem;
    color: var(--fg);
  }
  .man-text {
    font-size: clamp(1.9rem, 4.15vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-indent: 14%;
  }
  .man-text .w {
    color: rgb(236 238 232 / var(--o, 0.16));
    transition: color 0.2s linear;
  }
  .man-rule {
    margin-top: 12vh;
    --plus-x: 62%;
  }
  .man-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 4rem;
    gap: 2rem;
  }
  .man-micro {
    padding-left: calc((100% * 1 / 7.5) * 1.3);
  }
  .man-mission {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
    max-width: 30rem;
    margin-left: 24%;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  /* ----- marquee ----- */
  .marquee {
    position: relative;
    z-index: 1;
    padding-block: 6vh 34vh;
    overflow: clip;
  }
  .mq-top {
    margin-bottom: 12vh;
    padding-left: calc(var(--gutter) + 8vw);
  }
  .mq-band {
    overflow: hidden;
  }
  .mq-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .mq-set {
    display: flex;
    align-items: center;
    flex: none;
  }
  .mq-set span {
    font-size: clamp(5rem, 15vw, 16.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.86;
    text-transform: uppercase;
    font-stretch: 80%;
    color: #e7e9e3;
    padding-inline: 0.25em;
  }
  .mq-set i {
    font: 200 clamp(2rem, 4vw, 4rem) / 1 var(--f-mono);
    font-style: normal;
    color: var(--fg-muted);
    padding-inline: 0.4em;
  }
  .mq-sub {
    text-align: center;
    margin-top: 6vh;
  }

  @media (max-width: 860px) {
    .core-stage {
      --poster-x: 50%;
      --poster-y: 60%;
      --poster-h: 24vh;
    }
    .hero {
      height: 300vh;
    }
    .hero-title {
      font-size: clamp(3rem, 13.5vw, 5.6rem);
    }
    .hero-foot {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 1rem;
    }
    .hero-card,
    .scroll-cue {
      display: none;
    }
    .hold-wrap {
      justify-items: start;
      text-align: left;
    }
    .phase-captions {
      top: auto;
      bottom: 22vh;
    }
    .man-grid {
      grid-template-columns: 1fr;
    }
    .man-text {
      text-indent: 0;
    }
    .man-foot {
      grid-template-columns: 1fr;
    }
    .man-micro {
      padding-left: 0;
    }
    .man-mission {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero-ui {
      position: relative;
      min-height: 100svh;
    }
    .man-text .w {
      --o: 1;
    }
    .manifesto {
      margin-top: 0;
      padding-top: 16vh;
    }
    .cue-line i {
      animation: none;
    }
  }
</style>
