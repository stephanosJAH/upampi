---
import { faqs } from '../../data/content';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section class="faq chapter" id="faq" data-theme="light" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <p class="label spark">Preguntas frecuentes</p>
      <h2 id="faq-title" class="display d-l" data-split-reveal>Lo que suelen preguntarnos</h2>
      <p class="muted">¿No ves tu duda? Escríbenos y te respondemos en lenguaje claro.</p>
      <a class="mono-link" href="/contacto">Hacer una pregunta <span class="arrow">→</span></a>
    </div>
    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary>
              <span class="mono faq-i">0{i + 1}</span>
              <span class="faq-q">{f.q}</span>
              <span class="faq-plus" aria-hidden="true" />
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .faq {
    padding-block: 6vh 22vh;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  .faq-side {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-i {
    color: var(--fg-muted);
  }
  .faq-q {
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .faq-plus {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .faq-plus::before,
  .faq-plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out);
  }
  .faq-plus::after {
    transform: rotate(90deg);
  }
  details[open] .faq-plus::after {
    transform: rotate(0deg);
  }
  .faq-a {
    padding: 0 0 1.6rem 3.5rem;
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #2e3135;
  }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.55s var(--ease-out),
      content-visibility 0.55s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-side {
      position: relative;
      top: 0;
    }
    .faq-a {
      padding-left: 0;
    }
  }
</style>
