---
import Base from '../../layouts/Base.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import SolutionArt from '../../components/SolutionArt.astro';
import { services, type Service } from '../../data/services';
import { solutions } from '../../data/solutions';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props {
  s: Service;
}
const { s } = Astro.props;
const related = solutions.filter((x) => x.services.includes(s.slug)).slice(0, 3);
const others = services.filter((x) => x.slug !== s.slug);
---

<Base title={s.title} description={`${s.short} ${s.lead}`} theme="dark" ogImage={`/og/servicios/${s.slug}.png`}>
  <article class="svd chapter" data-theme="dark">
    <header class="wrap svd-head">
      <nav class="mono svd-crumbs" aria-label="Migas de pan">
        <a href="/servicios">← Servicios</a><span aria-hidden="true">/</span><span>{s.index}</span>
      </nav>
      <div class="svd-hero">
        <div class="svd-icon" transition:name={`svc-icon-${s.slug}`} data-vt-key={s.slug}>
          <ServiceIcon icon={s.icon} />
        </div>
        <div class="svd-titles">
          <h1 class="display d-xl" transition:name={`svc-title-${s.slug}`} data-vt-key={s.slug} style="view-transition-class: morph-title">{s.title}</h1>
          <p class="lede">{s.lead}</p>
        </div>
      </div>
    </header>

    <section class="wrap svd-block svd-problems" aria-labelledby="pb">
      <h2 id="pb" class="label spark">Si te suena familiar…</h2>
      <ul>
        {
          s.problems.map((p, i) => (
            <li data-reveal={i * 0.06}>
              <span class="mono">0{i + 1}</span>
              <p class="d-s">{p}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap svd-block" aria-labelledby="inc">
      <h2 id="inc" class="label spark">Qué incluye</h2>
      <div class="svd-includes">
        {
          s.includes.map((x) => (
            <div class="svd-inc" data-reveal>
              <h3 class="d-s">{x.title}</h3>
              <p class="muted">{x.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap svd-block svd-example" aria-labelledby="ex">
      <h2 id="ex" class="label">{s.example.label}</h2>
      <p class="display d-m" data-split-reveal>{s.example.text}</p>
    </section>

    <section class="wrap svd-block svd-start" aria-labelledby="st">
      <h2 id="st" class="label spark">Cómo empezamos</h2>
      <p class="d-s">{s.start}</p>
      <div class="svd-cta">
        <a class="pill magnetic" href={`/contacto?tipo=diagnostico&servicio=${s.slug}`}>Agenda un diagnóstico</a>
        <a class="mono-link" href={SITE.bookingUrl}>Llamada de 30 min <span class="arrow">→</span></a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="wrap svd-block" aria-labelledby="rel">
          <h2 id="rel" class="label spark">Soluciones relacionadas</h2>
          <ul class="svd-rel">
            {related.map((r) => (
              <li>
                <a href={`/soluciones/${r.slug}`} data-cursor-view="Explorar">
                  <div class="svd-rel-media" transition:name={`sol-media-${r.slug}`} data-vt-key={r.slug} style="view-transition-class: morph">
                    <SolutionArt art={r.art} tone={r.tone} />
                  </div>
                  <span class="mono muted">{r.industry}</span>
                  <h3 class="d-s" transition:name={`sol-title-${r.slug}`} data-vt-key={r.slug} style="view-transition-class: morph-title">
                    {r.title}
                  </h3>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="wrap svd-block svd-others" aria-label="Otros servicios">
      <p class="label">Otros servicios</p>
      <ul>
        {
          others.map((o) => (
            <li>
              <a href={`/servicios/${o.slug}`}>
                <span class="mono">{o.index}</span>
                <span class="svd-o-title" transition:name={`svc-title-${o.slug}`} data-vt-key={o.slug} style="view-transition-class: morph-title">
                  {o.title}
                </span>
                <span class="svd-o-ico" transition:name={`svc-icon-${o.slug}`} data-vt-key={o.slug}>
                  <ServiceIcon icon={o.icon} draw={false} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</Base>

<style>
  .svd {
    padding-top: calc(var(--header-h) + 8vh);
    padding-bottom: 16vh;
    background: var(--ink-1);
  }
  .svd-crumbs {
    display: flex;
    gap: 0.8rem;
    color: var(--fg-muted);
  }
  .svd-crumbs a:hover {
    color: var(--fg);
  }
  .svd-hero {
    margin-top: 6vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }
  .svd-icon {
    width: 100%;
    max-width: 280px;
    color: var(--signal);
  }
  .svd-titles {
    display: grid;
    gap: 2rem;
  }
  .svd-titles h1 {
    width: fit-content;
    max-width: 12ch;
  }
  .svd-titles .lede {
    max-width: 48ch;
    color: #c6c9c4;
  }
  .svd-block {
    margin-top: 16vh;
  }
  .svd-problems ul {
    margin-top: 2rem;
  }
  .svd-problems li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .svd-includes {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .svd-inc {
    background: var(--ink-1);
    padding: 2rem;
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }
  .svd-example {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
  }
  .svd-example .label {
    color: var(--signal);
  }
  .svd-start {
    display: grid;
    gap: 1.6rem;
    max-width: 60rem;
  }
  .svd-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
  }
  .svd-rel {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .svd-rel a {
    display: grid;
    gap: 0.8rem;
  }
  .svd-rel-media {
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
  }
  .svd-rel h3 {
    width: fit-content;
  }
  .svd-others ul {
    margin-top: 1.2rem;
  }
  .svd-others a {
    display: grid;
    grid-template-columns: 4rem 1fr 56px;
    align-items: center;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    transition: color 0.3s;
  }
  .svd-o-title {
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    width: fit-content;
  }
  .svd-o-ico {
    width: 56px;
    color: var(--fg-muted);
  }
  .svd-others a:hover .svd-o-ico {
    color: var(--signal);
  }
  @media (max-width: 860px) {
    .svd-hero,
    .svd-includes,
    .svd-rel {
      grid-template-columns: 1fr;
    }
    .svd-icon {
      max-width: 140px;
    }
  }
</style>
