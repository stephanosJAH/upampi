---
import Base from '../../layouts/Base.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { services } from '../../data/services';
---

<Base
  title="Servicios"
  description="Transformación digital, software a la medida, automatización e integraciones, implementación de IA, apps web y móviles, y dashboards para pymes y profesionales."
  theme="dark"
  ogImage="/og/servicios.png"
>
  <section class="svi chapter" data-theme="dark">
    <div class="wrap svi-head">
      <p class="label spark">Seis disciplinas. Un solo estándar: que funcione.</p>
      <h1 class="display d-xxl" data-split-reveal>Servicios</h1>
    </div>
    <ol class="wrap svi-list">
      {
        services.map((s) => (
          <li>
            <a href={`/servicios/${s.slug}`} class="svi-row">
              <span class="mono svi-i">{s.index}</span>
              <span class="svi-ico" transition:name={`svc-icon-${s.slug}`} data-vt-key={s.slug}>
                <ServiceIcon icon={s.icon} />
              </span>
              <span class="svi-title" transition:name={`svc-title-${s.slug}`} data-vt-key={s.slug} style="view-transition-class: morph-title">
                {s.title}
              </span>
              <span class="svi-short">{s.short}</span>
              <span class="mono svi-go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .svi {
    padding-top: calc(var(--header-h) + 10vh);
    padding-bottom: 18vh;
  }
  .svi-head {
    display: grid;
    gap: 1.6rem;
  }
  .svi-head h1 {
    font-size: clamp(4rem, 15vw, 17rem);
    line-height: 0.82;
    letter-spacing: -0.065em;
  }
  .svi-list {
    margin-top: 10vh;
  }
  .svi-row {
    display: grid;
    grid-template-columns: 3rem 72px minmax(0, 1.3fr) minmax(0, 1fr) 2rem;
    gap: 2rem;
    align-items: center;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .svi-list li:last-child .svi-row {
    border-bottom: 1px solid var(--line);
  }
  .svi-ico {
    color: #e9ebe5;
    transition: color 0.3s;
  }
  .svi-row:hover .svi-ico {
    color: var(--signal);
  }
  .svi-title {
    font-size: clamp(1.8rem, 3.6vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    width: fit-content;
    transition: transform 0.6s var(--ease-out);
  }
  .svi-row:hover .svi-title {
    transform: translateX(0.6rem);
  }
  .svi-short {
    color: var(--fg-muted);
  }
  .svi-go {
    transition: transform 0.4s var(--ease-out);
  }
  .svi-row:hover .svi-go {
    transform: translateX(6px);
    color: var(--signal);
  }
  @media (max-width: 860px) {
    .svi-row {
      grid-template-columns: 56px 1fr;
      gap: 1rem;
    }
    .svi-i,
    .svi-go {
      display: none;
    }
    .svi-short {
      grid-column: 1 / -1;
    }
  }
</style>
