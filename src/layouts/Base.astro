---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public, e.g. /og/default.png */
  ogImage?: string;
  /** Theme of the first chapter (header contrast before JS). */
  theme?: 'dark' | 'light';
  preloader?: boolean;
  footer?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/default.png',
  theme = 'dark',
  preloader = false,
  footer = true,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — UPAMPI` : 'UPAMPI — Smart Software para pymes y profesionales';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UPAMPI',
  slogan: 'Smart Software',
  url: SITE.url,
  logo: `${SITE.url}/icons/icon-512.png`,
  email: SITE.email,
  description: SITE.description,
};
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UPAMPI" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    {
      preloader && (
        <div class="preloader" data-preloader aria-hidden="true">
          <div class="pre-bands">
            {Array.from({ length: 8 }, () => (
              <i />
            ))}
          </div>
          <span class="pre-cross" />
        </div>
      )
    }
    <Header />
    <Menu />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <div class="cursor" data-cursor aria-hidden="true" transition:persist="cursor">
      <span class="cursor__ring"></span><span class="cursor__dot"></span><span class="cursor__label">Ver</span>
    </div>
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 160;
    pointer-events: none;
  }
  .pre-bands {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(8, 1fr);
  }
  .pre-bands i {
    display: block;
    margin: -0.5px 0;
    background: var(--fog-1);
    transform-origin: 50% 0;
    transition: transform 0.9s var(--ease-vt);
  }
  .pre-cross {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    transition:
      transform 0.7s var(--ease-vt),
      opacity 0.4s;
  }
  .pre-cross::before,
  .pre-cross::after {
    content: '';
    position: absolute;
    background: #0b0c0e;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
  }
  .pre-cross::before {
    width: 100%;
    height: 1px;
  }
  .pre-cross::after {
    width: 1px;
    height: 100%;
    animation: pre-spin 1.2s var(--ease-in-out) infinite;
  }
  @keyframes pre-spin {
    50% {
      transform: scaleY(0.2);
    }
  }
  .preloader.is-done .pre-cross {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }
  .preloader.is-done .pre-bands i {
    transform: scaleY(0);
  }
  .preloader.is-done .pre-bands i:nth-child(2n) {
    transform-origin: 50% 100%;
  }
  .preloader.is-done .pre-bands i:nth-child(1) { transition-delay: 0.05s; }
  .preloader.is-done .pre-bands i:nth-child(2) { transition-delay: 0.1s; }
  .preloader.is-done .pre-bands i:nth-child(3) { transition-delay: 0.15s; }
  .preloader.is-done .pre-bands i:nth-child(4) { transition-delay: 0.2s; }
  .preloader.is-done .pre-bands i:nth-child(5) { transition-delay: 0.25s; }
  .preloader.is-done .pre-bands i:nth-child(6) { transition-delay: 0.3s; }
  .preloader.is-done .pre-bands i:nth-child(7) { transition-delay: 0.35s; }
  .preloader.is-done .pre-bands i:nth-child(8) { transition-delay: 0.4s; }
  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none;
    }
  }
</style>
