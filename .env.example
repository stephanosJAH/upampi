# --- Formulario de contacto (POST /api/contact) ---
# Destinatario y remitente del correo de cada solicitud.
CONTACT_TO=hola@upampi.com
CONTACT_FROM="UPAMPI Web <web@upampi.com>"
# Si es "true", el visitante queda como Reply-To (recomendado).
CONTACT_REPLY_TO=true

# Opción A — Resend (https://resend.com). Si está definida, tiene prioridad.
RESEND_API_KEY=

# Opción B — SMTP (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" para TLS implícito (puerto 465)
SMTP_SECURE=false

# Sin credenciales: en desarrollo se registra el mensaje en consola y responde OK.
# En producción responde 503, salvo que actives el modo de prueba:
CONTACT_DRY_RUN=false

# Servidor Node (dist/server/entry.mjs)
HOST=127.0.0.1
PORT=4321
