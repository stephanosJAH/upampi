# /etc/systemd/system/upampi-contact.service
# Servidor Node de Astro: sirve POST /api/contact (los estáticos los entrega Caddy/Nginx).
[Unit]
Description=UPAMPI — servidor de contacto (Astro Node standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=upampi
Group=upampi
WorkingDirectory=/var/www/upampi/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
EnvironmentFile=/etc/upampi/contact.env
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=always
RestartSec=3
# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/upampi
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
